# ==============================================================================
# IEEE Protocol: The Network - Environment Configuration Template
# ==============================================================================

# JSON database storage directory (cross-process file lock persistent store)
PROTOCOL_DATA_DIR=.data

# Operations Desk Admin Credentials
ADMIN_AGENT_NAME=ieee-protocol-admin
ADMIN_PASSWORD=ieee_ops_secure_2025
ADMIN_SECRET_TOKEN=ieee_ops_secure_2025
ADMIN_SECRET=your_secret_signing_key_at_least_32_characters_here

# Official WhatsApp Group Invite Link (Message 1)
NEXT_PUBLIC_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/IEEE-Protocol-NITW-2026

# WhatsApp Automation Provider
# 'CUSTOM' connects directly to your local zero-cost Baileys gateway (npm run wa:gateway)
WHATSAPP_PROVIDER=CUSTOM
CUSTOM_WHATSAPP_WEBHOOK_URL=http://localhost:5005/send
WA_GATEWAY_URL=http://localhost:5005
WA_GATEWAY_PORT=5005
