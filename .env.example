# IEEE Protocol: The Network - Environment Configuration
# Optional: If unset or left as dummy values, the app will run with full local interactive mock store & simulation!
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
ADMIN_SECRET_TOKEN=ieee_ops_secure_2025

# WhatsApp Automation Configuration
# Message 1 Group Link
NEXT_PUBLIC_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/IEEE-Protocol-NITW-2026

# Provider: 'CUSTOM' (Zero-cost Baileys Gateway) | 'SIMULATED' | 'META_CLOUD' | 'ULTRAMSG'
WHATSAPP_PROVIDER=CUSTOM

# 100% Free Baileys Gateway (Run via: npm run wa:gateway)
CUSTOM_WHATSAPP_WEBHOOK_URL=http://localhost:5005/send
WA_GATEWAY_PORT=5005

# Meta WhatsApp Cloud API (Optional: required only if WHATSAPP_PROVIDER=META_CLOUD)
WHATSAPP_API_TOKEN=your-meta-cloud-api-token-here
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id-here

# UltraMsg (Optional: required only if WHATSAPP_PROVIDER=ULTRAMSG)
ULTRAMSG_INSTANCE_ID=instance12345
ULTRAMSG_TOKEN=your-ultramsg-token

