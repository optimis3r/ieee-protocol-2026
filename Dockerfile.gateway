FROM node:20-alpine

WORKDIR /app

# Copy package descriptors
COPY package*.json ./

# Install production dependencies
RUN npm install --omit=dev

# Copy gateway runner script
COPY scripts/whatsapp-gateway.mjs ./scripts/

EXPOSE 5005

ENV PORT=5005
ENV NODE_ENV=production

CMD ["node", "scripts/whatsapp-gateway.mjs"]
